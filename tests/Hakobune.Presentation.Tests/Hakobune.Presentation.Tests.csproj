<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit v3 のテストは実行ファイルになるので、dotnet run でも実行できる -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hakobune.Presentation\Hakobune.Presentation.csproj" />
  </ItemGroup>

  <!-- 実サーバーでのテストの接続先は、エンジンのテストと同じものを使う -->
  <ItemGroup>
    <Compile Include="..\Hakobune.Core.Tests\Integration\TestServers.cs" Link="Integration\TestServers.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

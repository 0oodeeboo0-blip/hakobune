<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hakobune.App.Views.FilePaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:files="using:Hakobune.Presentation.Files"
    xmlns:helpers="using:Hakobune.App.Helpers"
    GotFocus="OnGotFocus">

    <!--  Ctrl+F で絞り込み、Alt+↑ で上のフォルダ、F5 で取り直し  -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="F"
            Invoked="OnFindInvoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Up"
            Invoked="OnGoUpInvoked"
            Modifiers="Menu" />
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
        <!--  FFFTP と同じ: Ctrl+K で新しいフォルダ、Ctrl+N で名前の変更、Ctrl+T で属性の変更  -->
        <KeyboardAccelerator
            Key="K"
            Invoked="OnNewFolderInvoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="N"
            Invoked="OnRenameInvoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="T"
            Invoked="OnPermissionsInvoked"
            Modifiers="Control" />
    </UserControl.KeyboardAccelerators>

    <UserControl.Resources>
        <!--  一覧の 1 行: アイコン、名前、大きさ、更新日時、属性  -->
        <DataTemplate x:Key="FileRowTemplate" x:DataType="files:FileRowViewModel">
            <Grid>
                <!--  取り直しで増えた・変わった行の光（ふだんは見えない。FilePaneView.xaml.cs が光らせて消す）。
                      形は、選んだ行やマウスを乗せた行の背景と同じ（行の内側に左右 4・上下 2、角丸 4）  -->
                <Border
                    Margin="-10,2"
                    Background="{ThemeResource HakobuneRowGlowBrush}"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Opacity="0" />
                <Grid VerticalAlignment="Center" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!--  アイコンと名前を掴むとファイルのドラッグ。それ以外の所から引くと、囲んで選ぶ（Tag で見分ける）  -->
                        <Grid
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Tag="RowHandle">
                            <!--  フォルダ  -->
                            <Path
                                Data="M 2.5,6 A 1.75,1.75 0 0 1 4.25,4.25 L 7.35,4.25 C 7.75,4.25 8.13,4.41 8.41,4.69 L 9.6,5.9 L 15.75,5.9 A 1.75,1.75 0 0 1 17.5,7.65 L 17.5,14.25 A 1.75,1.75 0 0 1 15.75,16 L 4.25,16 A 1.75,1.75 0 0 1 2.5,14.25 Z"
                                Fill="{ThemeResource HakobuneFolderFillBrush}"
                                Stroke="{ThemeResource HakobuneFolderStrokeBrush}"
                                StrokeThickness="1"
                                Visibility="{x:Bind IsFolder}" />
                            <Path
                                Data="M 2.5,8.1 L 17.5,8.1"
                                Opacity="0.55"
                                Stroke="{ThemeResource HakobuneFolderStrokeBrush}"
                                StrokeThickness="1"
                                Visibility="{x:Bind IsFolder}" />
                            <!--  ドライブ  -->
                            <Canvas Visibility="{x:Bind IsDrive}">
                                <Rectangle
                                    Canvas.Left="2"
                                    Canvas.Top="5.5"
                                    Width="16"
                                    Height="9"
                                    RadiusX="2.5"
                                    RadiusY="2.5"
                                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                    StrokeThickness="1.5" />
                                <Path
                                    Data="M 5.5,10 L 9,10"
                                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.5" />
                                <Ellipse
                                    Canvas.Left="13.1"
                                    Canvas.Top="9.1"
                                    Width="1.8"
                                    Height="1.8"
                                    Fill="{ThemeResource HakobuneAccentTextBrush}" />
                            </Canvas>
                            <!--  ファイルの紙（すべてのファイルに共通）  -->
                            <Path
                                Data="M 5.5,2.75 L 11.25,2.75 L 14.75,6.25 L 14.75,16.25 A 1.5,1.5 0 0 1 13.25,17.75 L 5.5,17.75 A 1.5,1.5 0 0 1 4,16.25 L 4,4.25 A 1.5,1.5 0 0 1 5.5,2.75 Z M 11,2.75 L 11,6.5 L 14.75,6.5"
                                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.5"
                                Visibility="{x:Bind IsFile}" />
                            <!--  プログラム  -->
                            <Path
                                Data="M 8.25,10.25 L 6.75,11.75 L 8.25,13.25 M 11.75,10.25 L 13.25,11.75 L 11.75,13.25"
                                Stroke="{ThemeResource HakobuneAccentTextBrush}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.5"
                                Visibility="{x:Bind IsCode}" />
                            <!--  画像  -->
                            <Path
                                Data="M 6.6,15.25 L 8.9,12.5 L 10.65,14.5 L 11.85,13.05 L 13.6,15.25"
                                Stroke="{ThemeResource HakobuneAccentTextBrush}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.5"
                                Visibility="{x:Bind IsImage}" />
                            <Canvas Visibility="{x:Bind IsImage}">
                                <Ellipse
                                    Canvas.Left="6.6"
                                    Canvas.Top="7.95"
                                    Width="3.6"
                                    Height="3.6"
                                    Stroke="{ThemeResource HakobuneAccentTextBrush}"
                                    StrokeThickness="1.5" />
                            </Canvas>
                            <!--  圧縮ファイル  -->
                            <Path
                                Data="M 8.6,5.25 L 9.9,5.25 M 8.6,7.5 L 9.9,7.5 M 8.6,9.75 L 9.9,9.75"
                                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.5"
                                Visibility="{x:Bind IsArchive}" />
                            <Canvas Visibility="{x:Bind IsArchive}">
                                <Rectangle
                                    Canvas.Left="7.15"
                                    Canvas.Top="11"
                                    Width="4.2"
                                    Height="4.5"
                                    RadiusX="1.45"
                                    RadiusY="1.45"
                                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                    StrokeThickness="1.5" />
                            </Canvas>
                            <!--  テキスト・文書  -->
                            <Path
                                Data="M 6.75,10.25 L 12,10.25 M 6.75,12.5 L 12,12.5 M 6.75,14.75 L 10,14.75"
                                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.5"
                                Visibility="{x:Bind IsText}" />
                            <!--  音声・動画  -->
                            <Path
                                Data="M 8.5,10.5 L 8.5,15 L 12.25,12.75 Z"
                                Fill="{ThemeResource HakobuneAccentTextBrush}"
                                Visibility="{x:Bind IsMedia}" />
                        </Grid>
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Opacity="{x:Bind NameOpacity}"
                            Tag="RowHandle"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis" />
                        <!--  送らないファイルの印（パソコン側の一覧だけ）  -->
                        <Border
                            Grid.Column="2"
                            Padding="6,0,6,1"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="9"
                            Tag="RowHandle"
                            ToolTipService.ToolTip="{x:Bind ExcludedTip}"
                            Visibility="{x:Bind IsExcluded}">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="送らない" />
                        </Border>
                    </Grid>
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        Text="{x:Bind SizeText}" />
                    <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        Text="{x:Bind ModifiedText}" />
                    <TextBlock
                        Grid.Column="3"
                        Width="84"
                        FontFamily="Cascadia Mono, Consolas"
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        Text="{x:Bind Permissions}"
                        Visibility="{x:Bind ShowsPermissions}" />
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid
        AllowDrop="True"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource OverlayCornerRadius}"
        DragOver="OnDragOver"
        Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  見出し  -->
        <Grid Padding="14,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid
                Width="20"
                Height="20"
                VerticalAlignment="Center">
                <!--  パソコン  -->
                <Canvas Visibility="{x:Bind ViewModel.IsLocal, Mode=OneWay}">
                    <Rectangle
                        Canvas.Left="2"
                        Canvas.Top="2.75"
                        Width="16"
                        Height="11.25"
                        RadiusX="2.25"
                        RadiusY="2.25"
                        Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                        StrokeThickness="1.5" />
                    <Path
                        Data="M 7.25,16.5 L 12.75,16.5 M 10,13.25 L 10,16.5"
                        Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                        StrokeEndLineCap="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="1.5" />
                </Canvas>
                <!--  サーバー  -->
                <Canvas Visibility="{x:Bind ViewModel.IsRemote, Mode=OneWay}">
                    <Rectangle
                        Canvas.Left="2.25"
                        Canvas.Top="2.5"
                        Width="15.5"
                        Height="7.25"
                        RadiusX="2.25"
                        RadiusY="2.25"
                        Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                        StrokeThickness="1.5" />
                    <Rectangle
                        Canvas.Left="2.25"
                        Canvas.Top="10.25"
                        Width="15.5"
                        Height="7.25"
                        RadiusX="2.25"
                        RadiusY="2.25"
                        Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                        StrokeThickness="1.5" />
                    <Ellipse
                        Canvas.Left="5.35"
                        Canvas.Top="5.2"
                        Width="1.8"
                        Height="1.8"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse
                        Canvas.Left="5.35"
                        Canvas.Top="13"
                        Width="1.8"
                        Height="1.8"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                </Canvas>
            </Grid>
            <TextBlock
                Grid.Column="1"
                Style="{StaticResource PaneTitleTextStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
            <TextBlock
                Grid.Column="3"
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
        </Grid>

        <!--  上のフォルダへ、いまの場所、絞り込み  -->
        <Grid
            Grid.Row="1"
            Padding="10,0,10,8"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="168" />
            </Grid.ColumnDefinitions>
            <Button
                Width="32"
                Height="32"
                AutomationProperties.Name="上のフォルダへ"
                Command="{x:Bind ViewModel.GoUpCommand, Mode=OneWay}"
                Style="{StaticResource SubtleIconButtonStyle}"
                ToolTipService.ToolTip="上のフォルダへ (Backspace)">
                <FontIcon FontSize="14" Glyph="&#xE74A;" />
            </Button>
            <Border
                Grid.Column="1"
                Height="32"
                Padding="6,0"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Visibility="{x:Bind ViewModel.HasSource, Mode=OneWay}">
                <BreadcrumbBar
                    VerticalAlignment="Center"
                    AutomationProperties.Name="いまのフォルダ"
                    ItemClicked="OnBreadcrumbClicked"
                    ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}" />
            </Border>
            <Grid Grid.Column="2" Visibility="{x:Bind ViewModel.HasSource, Mode=OneWay}">
                <TextBox
                    x:Name="FilterBox"
                    Padding="32,5,6,6"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="絞り込み"
                    KeyDown="OnFilterKeyDown"
                    PlaceholderText="絞り込み"
                    Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <FontIcon
                    Margin="11,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE721;"
                    IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <!--  お知らせ（一覧を更新できなかったときなど）。一覧は消さずに残す。狭くても 2 行に収まるよう、ボタンは右に置く  -->
        <Border
            Grid.Row="2"
            Margin="10,0,10,8"
            Padding="12,8,8,8"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="{x:Bind ViewModel.MessageTitle, Mode=OneWay}"
            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
            BorderBrush="{ThemeResource HakobuneWarningStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Canvas
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center">
                    <Ellipse
                        Canvas.Left="2"
                        Canvas.Top="2"
                        Width="16"
                        Height="16"
                        Fill="{ThemeResource HakobuneWarningIconBrush}" />
                    <Path
                        Data="M 10,5.75 L 10,10.75"
                        Stroke="{ThemeResource HakobuneWarningGlyphBrush}"
                        StrokeEndLineCap="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="1.75" />
                    <Ellipse
                        Canvas.Left="8.95"
                        Canvas.Top="12.85"
                        Width="2.1"
                        Height="2.1"
                        Fill="{ThemeResource HakobuneWarningGlyphBrush}" />
                </Canvas>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.MessageTitle, Mode=OneWay}" />
                        <Run
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.MessageReason, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.MessageText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasMessageText, Mode=OneWay}" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.RetryCommand, Mode=OneWay}"
                    Content="{x:Bind ViewModel.RetryText, Mode=OneWay}" />
            </Grid>
        </Border>

        <!--  列の見出し（押すと並べ替え）  -->
        <Grid
            Grid.Row="3"
            Padding="14,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="124" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="OnSortByName" Style="{StaticResource ColumnHeaderButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="名前" />
                    <FontIcon
                        FontSize="10"
                        Glyph="&#xE70E;"
                        RenderTransformOrigin="0.5,0.5"
                        Visibility="{x:Bind ViewModel.IsSortedByName, Mode=OneWay}">
                        <FontIcon.RenderTransform>
                            <RotateTransform Angle="{x:Bind ViewModel.SortArrowAngle, Mode=OneWay}" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </StackPanel>
            </Button>
            <Button
                Grid.Column="1"
                HorizontalAlignment="Right"
                Click="OnSortBySize"
                Style="{StaticResource ColumnHeaderButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon
                        FontSize="10"
                        Glyph="&#xE70E;"
                        RenderTransformOrigin="0.5,0.5"
                        Visibility="{x:Bind ViewModel.IsSortedBySize, Mode=OneWay}">
                        <FontIcon.RenderTransform>
                            <RotateTransform Angle="{x:Bind ViewModel.SortArrowAngle, Mode=OneWay}" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                    <TextBlock Text="サイズ" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                Click="OnSortByModified"
                Style="{StaticResource ColumnHeaderButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="更新日時" />
                    <FontIcon
                        FontSize="10"
                        Glyph="&#xE70E;"
                        RenderTransformOrigin="0.5,0.5"
                        Visibility="{x:Bind ViewModel.IsSortedByModified, Mode=OneWay}">
                        <FontIcon.RenderTransform>
                            <RotateTransform Angle="{x:Bind ViewModel.SortArrowAngle, Mode=OneWay}" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </StackPanel>
            </Button>
            <TextBlock
                Grid.Column="3"
                Width="84"
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Text="属性"
                Visibility="{x:Bind ViewModel.ShowsPermissions, Mode=OneWay}" />
        </Grid>

        <!--  一覧  -->
        <!--  行の無い所でもマウスを受け取れるよう、背景は透明にしておく（囲んで選ぶため）  -->
        <ListView
            x:Name="FileList"
            Grid.Row="4"
            Padding="0,4"
            Background="Transparent"
            CanDragItems="True"
            ContainerContentChanging="OnContainerContentChanging"
            DoubleTapped="OnListDoubleTapped"
            DragItemsStarting="OnDragItemsStarting"
            ItemContainerStyle="{x:Bind helpers:Ui.FileRowStyle(ViewModel.UseCompactRows), Mode=OneWay}"
            ItemTemplate="{StaticResource FileRowTemplate}"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
            KeyDown="OnListKeyDown"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Extended">
            <!--  一覧を取り直したときに行が拡大・縮小しないよう、出入りの動きは付けない  -->
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
        </ListView>
        <!--  マウスで囲んで選ぶときの枠（FilePaneView.xaml.cs が出す）  -->
        <Canvas
            x:Name="MarqueeLayer"
            Grid.Row="4"
            IsHitTestVisible="False">
            <Rectangle
                x:Name="MarqueeBox"
                Fill="{ThemeResource HakobuneAccentTintBrush}"
                RadiusX="2"
                RadiusY="2"
                Stroke="{ThemeResource HakobuneAccentTextBrush}"
                StrokeThickness="1"
                Visibility="Collapsed" />
        </Canvas>
        <StackPanel
            Grid.Row="4"
            MaxWidth="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Spacing="4"
            Visibility="{x:Bind ViewModel.ShowsEmptyText, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
        <ProgressRing
            Grid.Row="4"
            Width="32"
            Height="32"
            IsActive="{x:Bind ViewModel.ShowsProgress, Mode=OneWay}"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hakobune.App.Views.FilePaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:files="using:Hakobune.Presentation.Files">

    <UserControl.Resources>
        <!--  一覧の 1 行: アイコン、名前、大きさ、更新日時、属性  -->
        <DataTemplate x:Key="FileRowTemplate" x:DataType="files:FileRowViewModel">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="124" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center">
                        <!--  フォルダ  -->
                        <Path
                            Data="M 2.5,6 A 1.75,1.75 0 0 1 4.25,4.25 L 7.35,4.25 C 7.75,4.25 8.13,4.41 8.41,4.69 L 9.6,5.9 L 15.75,5.9 A 1.75,1.75 0 0 1 17.5,7.65 L 17.5,14.25 A 1.75,1.75 0 0 1 15.75,16 L 4.25,16 A 1.75,1.75 0 0 1 2.5,14.25 Z"
                            Fill="{ThemeResource HakobuneFolderFillBrush}"
                            Stroke="{ThemeResource HakobuneFolderStrokeBrush}"
                            StrokeThickness="1"
                            Visibility="{x:Bind IsFolder}" />
                        <Path
                            Data="M 2.5,8.1 L 17.5,8.1"
                            Opacity="0.55"
                            Stroke="{ThemeResource HakobuneFolderStrokeBrush}"
                            StrokeThickness="1"
                            Visibility="{x:Bind IsFolder}" />
                        <!--  ファイルの紙（すべてのファイルに共通）  -->
                        <Path
                            Data="M 5.5,2.75 L 11.25,2.75 L 14.75,6.25 L 14.75,16.25 A 1.5,1.5 0 0 1 13.25,17.75 L 5.5,17.75 A 1.5,1.5 0 0 1 4,16.25 L 4,4.25 A 1.5,1.5 0 0 1 5.5,2.75 Z M 11,2.75 L 11,6.5 L 14.75,6.5"
                            Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5"
                            Visibility="{x:Bind IsFile}" />
                        <!--  プログラム  -->
                        <Path
                            Data="M 8.25,10.25 L 6.75,11.75 L 8.25,13.25 M 11.75,10.25 L 13.25,11.75 L 11.75,13.25"
                            Stroke="{ThemeResource HakobuneAccentTextBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5"
                            Visibility="{x:Bind IsCode}" />
                        <!--  画像  -->
                        <Path
                            Data="M 6.6,15.25 L 8.9,12.5 L 10.65,14.5 L 11.85,13.05 L 13.6,15.25"
                            Stroke="{ThemeResource HakobuneAccentTextBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5"
                            Visibility="{x:Bind IsImage}" />
                        <Canvas Visibility="{x:Bind IsImage}">
                            <Ellipse
                                Canvas.Left="6.6"
                                Canvas.Top="7.95"
                                Width="3.6"
                                Height="3.6"
                                Stroke="{ThemeResource HakobuneAccentTextBrush}"
                                StrokeThickness="1.5" />
                        </Canvas>
                        <!--  圧縮ファイル  -->
                        <Path
                            Data="M 8.6,5.25 L 9.9,5.25 M 8.6,7.5 L 9.9,7.5 M 8.6,9.75 L 9.9,9.75"
                            Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5"
                            Visibility="{x:Bind IsArchive}" />
                        <Canvas Visibility="{x:Bind IsArchive}">
                            <Rectangle
                                Canvas.Left="7.15"
                                Canvas.Top="11"
                                Width="4.2"
                                Height="4.5"
                                RadiusX="1.45"
                                RadiusY="1.45"
                                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                StrokeThickness="1.5" />
                        </Canvas>
                        <!--  テキスト・文書  -->
                        <Path
                            Data="M 6.75,10.25 L 12,10.25 M 6.75,12.5 L 12,12.5 M 6.75,14.75 L 10,14.75"
                            Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5"
                            Visibility="{x:Bind IsText}" />
                        <!--  音声・動画  -->
                        <Path
                            Data="M 8.5,10.5 L 8.5,15 L 12.25,12.75 Z"
                            Fill="{ThemeResource HakobuneAccentTextBrush}"
                            Visibility="{x:Bind IsMedia}" />
                    </Grid>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryCaptionTextStyle}"
                    Text="{x:Bind SizeText}" />
                <TextBlock
                    Grid.Column="2"
                    Style="{StaticResource SecondaryCaptionTextStyle}"
                    Text="{x:Bind ModifiedText}" />
                <TextBlock
                    Grid.Column="3"
                    Width="84"
                    FontFamily="Cascadia Mono, Consolas"
                    Style="{StaticResource SecondaryCaptionTextStyle}"
                    Text="{x:Bind Permissions}"
                    Visibility="{x:Bind ShowsPermissions}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource OverlayCornerRadius}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  見出し  -->
        <Grid Padding="14,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid
                Width="20"
                Height="20"
                VerticalAlignment="Center">
                <!--  パソコン  -->
                <Canvas Visibility="{x:Bind ViewModel.IsLocal, Mode=OneWay}">
                    <Rectangle
                        Canvas.Left="2"
                        Canvas.Top="2.75"
                        Width="16"
                        Height="11.25"
                        RadiusX="2.25"
                        RadiusY="2.25"
                        Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                        StrokeThickness="1.5" />
                    <Path
                        Data="M 7.25,16.5 L 12.75,16.5 M 10,13.25 L 10,16.5"
                        Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                        StrokeEndLineCap="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="1.5" />
                </Canvas>
                <!--  サーバー  -->
                <Canvas Visibility="{x:Bind ViewModel.IsRemote, Mode=OneWay}">
                    <Rectangle
                        Canvas.Left="2.25"
                        Canvas.Top="2.5"
                        Width="15.5"
                        Height="7.25"
                        RadiusX="2.25"
                        RadiusY="2.25"
                        Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                        StrokeThickness="1.5" />
                    <Rectangle
                        Canvas.Left="2.25"
                        Canvas.Top="10.25"
                        Width="15.5"
                        Height="7.25"
                        RadiusX="2.25"
                        RadiusY="2.25"
                        Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                        StrokeThickness="1.5" />
                    <Ellipse
                        Canvas.Left="5.35"
                        Canvas.Top="5.2"
                        Width="1.8"
                        Height="1.8"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse
                        Canvas.Left="5.35"
                        Canvas.Top="13"
                        Width="1.8"
                        Height="1.8"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                </Canvas>
            </Grid>
            <TextBlock
                Grid.Column="1"
                Style="{StaticResource PaneTitleTextStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
            <TextBlock
                Grid.Column="3"
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
        </Grid>

        <!--  上のフォルダへ、いまの場所、絞り込み  -->
        <Grid
            Grid.Row="1"
            Padding="10,0,10,8"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="168" />
            </Grid.ColumnDefinitions>
            <Button
                Width="32"
                Height="32"
                AutomationProperties.Name="上のフォルダへ"
                Command="{x:Bind ViewModel.GoUpCommand, Mode=OneWay}"
                Style="{StaticResource SubtleIconButtonStyle}"
                ToolTipService.ToolTip="上のフォルダへ (Backspace)">
                <FontIcon FontSize="14" Glyph="&#xE74A;" />
            </Button>
            <Border
                Grid.Column="1"
                Height="32"
                Padding="6,0"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <BreadcrumbBar
                    VerticalAlignment="Center"
                    AutomationProperties.Name="いまのフォルダ"
                    ItemClicked="OnBreadcrumbClicked"
                    ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}" />
            </Border>
            <Grid Grid.Column="2">
                <TextBox
                    Padding="32,5,6,6"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="絞り込み"
                    PlaceholderText="絞り込み"
                    Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <FontIcon
                    Margin="11,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE721;"
                    IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <!--  お知らせ（一覧を更新できなかったときなど）。一覧は消さずに残す  -->
        <InfoBar
            Grid.Row="2"
            Margin="10,0,10,8"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
            Message="{x:Bind ViewModel.MessageText, Mode=OneWay}"
            Severity="Warning"
            Title="{x:Bind ViewModel.MessageTitle, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.RetryCommand, Mode=OneWay}" Content="今すぐ再試行" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!--  列の見出し（押すと並べ替え）  -->
        <Grid
            Grid.Row="3"
            Padding="14,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="124" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="OnSortByName" Style="{StaticResource ColumnHeaderButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="名前" />
                    <FontIcon
                        FontSize="10"
                        Glyph="&#xE70E;"
                        RenderTransformOrigin="0.5,0.5"
                        Visibility="{x:Bind ViewModel.IsSortedByName, Mode=OneWay}">
                        <FontIcon.RenderTransform>
                            <RotateTransform Angle="{x:Bind ViewModel.SortArrowAngle, Mode=OneWay}" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </StackPanel>
            </Button>
            <Button
                Grid.Column="1"
                HorizontalAlignment="Right"
                Click="OnSortBySize"
                Style="{StaticResource ColumnHeaderButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon
                        FontSize="10"
                        Glyph="&#xE70E;"
                        RenderTransformOrigin="0.5,0.5"
                        Visibility="{x:Bind ViewModel.IsSortedBySize, Mode=OneWay}">
                        <FontIcon.RenderTransform>
                            <RotateTransform Angle="{x:Bind ViewModel.SortArrowAngle, Mode=OneWay}" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                    <TextBlock Text="サイズ" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                Click="OnSortByModified"
                Style="{StaticResource ColumnHeaderButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="更新日時" />
                    <FontIcon
                        FontSize="10"
                        Glyph="&#xE70E;"
                        RenderTransformOrigin="0.5,0.5"
                        Visibility="{x:Bind ViewModel.IsSortedByModified, Mode=OneWay}">
                        <FontIcon.RenderTransform>
                            <RotateTransform Angle="{x:Bind ViewModel.SortArrowAngle, Mode=OneWay}" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </StackPanel>
            </Button>
            <TextBlock
                Grid.Column="3"
                Width="84"
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Text="属性"
                Visibility="{x:Bind ViewModel.ShowsPermissions, Mode=OneWay}" />
        </Grid>

        <!--  一覧  -->
        <ListView
            x:Name="FileList"
            Grid.Row="4"
            Padding="0,4"
            DoubleTapped="OnListDoubleTapped"
            ItemContainerStyle="{StaticResource FileRowContainerStyle}"
            ItemTemplate="{StaticResource FileRowTemplate}"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
            KeyDown="OnListKeyDown"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Extended" />
        <StackPanel
            Grid.Row="4"
            MaxWidth="320"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="4"
            Visibility="{x:Bind ViewModel.ShowsEmptyText, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
        <ProgressRing
            Grid.Row="4"
            Width="32"
            Height="32"
            IsActive="{x:Bind ViewModel.ShowsProgress, Mode=OneWay}" />
    </Grid>
</UserControl>

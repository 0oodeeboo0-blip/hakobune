<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hakobune.App.Views.TransferPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:backups="using:Hakobune.Presentation.Backups"
    xmlns:helpers="using:Hakobune.App.Helpers"
    xmlns:logging="using:Hakobune.Presentation.Logging"
    xmlns:transfers="using:Hakobune.Presentation.Transfers">

    <Grid
        Height="{x:Bind helpers:Ui.TransferPanelHeight(ViewModel.IsExpanded, ViewModel.PanelHeight), Mode=OneWay}"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource OverlayCornerRadius}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  見出し: タブ、件数、失敗分を再送  -->
        <Grid
            MinHeight="48"
            Padding="14,6,8,6"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="{x:Bind helpers:Ui.BottomLine(ViewModel.IsExpanded), Mode=OneWay}"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource PaneTitleTextStyle}" Text="転送" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="2">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="transfers:TransferTabViewModel">
                        <Button
                            AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                            Click="OnTabClick"
                            Style="{StaticResource TabButtonStyle}">
                            <Grid>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="{x:Bind helpers:Ui.SemiBoldIf(IsSelected), Mode=OneWay}"
                                        Opacity="{x:Bind helpers:Ui.DimUnless(IsSelected), Mode=OneWay}"
                                        Text="{x:Bind Label}" />
                                    <Grid
                                        Height="18"
                                        MinWidth="22"
                                        VerticalAlignment="Center">
                                        <Border
                                            Padding="6,0"
                                            Background="{ThemeResource HakobuneBadgeBrush}"
                                            CornerRadius="9"
                                            Visibility="{x:Bind ShowsNormalBadge, Mode=OneWay}">
                                            <TextBlock Style="{StaticResource BadgeTextStyle}" Text="{x:Bind CountText, Mode=OneWay}" />
                                        </Border>
                                        <Border
                                            Padding="6,0"
                                            Background="{ThemeResource HakobuneFailedBadgeBrush}"
                                            CornerRadius="9"
                                            Visibility="{x:Bind ShowsAlertBadge, Mode=OneWay}">
                                            <TextBlock
                                                Foreground="{ThemeResource HakobuneFailedTextBrush}"
                                                Style="{StaticResource BadgeTextStyle}"
                                                Text="{x:Bind CountText, Mode=OneWay}" />
                                        </Border>
                                        <Border
                                            Padding="6,0"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="9"
                                            Visibility="{x:Bind ShowsSelectedBadge, Mode=OneWay}">
                                            <TextBlock
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Style="{StaticResource BadgeTextStyle}"
                                                Text="{x:Bind CountText, Mode=OneWay}" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                <Rectangle
                                    Height="3"
                                    Margin="0,0,0,1"
                                    VerticalAlignment="Bottom"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Rectangle
                Width="1"
                Height="18"
                Margin="6,0"
                VerticalAlignment="Center"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <!--  ログ（接続・転送・操作の記録）  -->
            <Button
                AutomationProperties.Name="ログ"
                Click="OnLogTabClick"
                Style="{StaticResource TabButtonStyle}"
                ToolTipService.ToolTip="接続・転送・ファイルの操作の記録">
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="{x:Bind helpers:Ui.SemiBoldIf(ViewModel.IsLogSelected), Mode=OneWay}"
                        Opacity="{x:Bind helpers:Ui.DimUnless(ViewModel.IsLogSelected), Mode=OneWay}"
                        Text="ログ" />
                    <Rectangle
                        Height="3"
                        Margin="0,0,0,1"
                        VerticalAlignment="Bottom"
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        RadiusX="1.5"
                        RadiusY="1.5"
                        Visibility="{x:Bind ViewModel.IsLogSelected, Mode=OneWay}" />
                </Grid>
            </Button>
            <!--  控え（上書き・削除の前の元のファイル）  -->
            <Button
                AutomationProperties.Name="控え"
                Click="OnBackupsTabClick"
                Style="{StaticResource TabButtonStyle}"
                ToolTipService.ToolTip="上書き・削除する前に取った、元のファイルの控え（元に戻せます）">
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="{x:Bind helpers:Ui.SemiBoldIf(ViewModel.IsBackupsSelected), Mode=OneWay}"
                        Opacity="{x:Bind helpers:Ui.DimUnless(ViewModel.IsBackupsSelected), Mode=OneWay}"
                        Text="控え" />
                    <Rectangle
                        Height="3"
                        Margin="0,0,0,1"
                        VerticalAlignment="Bottom"
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        RadiusX="1.5"
                        RadiusY="1.5"
                        Visibility="{x:Bind ViewModel.IsBackupsSelected, Mode=OneWay}" />
                </Grid>
            </Button>
            </StackPanel>
            <!--  一時停止中なら、その理由。そうでなければ件数  -->
            <StackPanel
                Grid.Column="3"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="{x:Bind ViewModel.IsPaused, Mode=OneWay}">
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource HakobuneWarningTagTextBrush}"
                    Glyph="&#xE769;" />
                <TextBlock
                    MaxWidth="420"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource HakobuneWarningTagTextBrush}"
                    Text="{x:Bind ViewModel.PauseText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PauseText, Mode=OneWay}" />
            </StackPanel>
            <TextBlock
                Grid.Column="3"
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                Visibility="{x:Bind helpers:Ui.VisibleUnless(ViewModel.IsPaused), Mode=OneWay}" />
            <Button
                Grid.Column="4"
                Height="32"
                Padding="12,0"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.RetryFailedCommand, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock FontWeight="SemiBold" Text="失敗分を再送" />
                </StackPanel>
            </Button>
            <StackPanel
                Grid.Column="5"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    Width="32"
                    Height="32"
                    AutomationProperties.Name="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.PauseAllCommand, Mode=OneWay}"
                    Style="{StaticResource SubtleIconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.PauseButtonGlyph, Mode=OneWay}" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    AutomationProperties.Name="転送のその他の操作"
                    Style="{StaticResource SubtleIconButtonStyle}"
                    ToolTipService.ToolTip="その他の操作">
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Command="{x:Bind ViewModel.ClearFinishedCommand, Mode=OneWay}" Text="終わった項目を一覧から消す">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <Button
                Grid.Column="6"
                Width="32"
                Height="32"
                AutomationProperties.Name="転送の一覧を開閉"
                Command="{x:Bind ViewModel.ToggleExpandedCommand, Mode=OneWay}"
                Style="{StaticResource SubtleIconButtonStyle}"
                ToolTipService.ToolTip="転送の一覧を開閉">
                <FontIcon
                    FontSize="12"
                    Glyph="&#xE70D;"
                    RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <RotateTransform Angle="{x:Bind ViewModel.ExpandGlyphRotation, Mode=OneWay}" />
                    </FontIcon.RenderTransform>
                </FontIcon>
            </Button>
        </Grid>

        <!--  転送の一覧とログ  -->
        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.IsExpanded, Mode=OneWay}">
            <Grid Visibility="{x:Bind helpers:Ui.VisibleUnlessAny(ViewModel.IsLogSelected, ViewModel.IsBackupsSelected), Mode=OneWay}">
            <ListView
                Padding="0,4"
                ItemContainerStyle="{StaticResource TransferRowContainerStyle}"
                ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                SelectionMode="Extended">
                <!--  行が増えたり移ったりしても、拡大・縮小の動きは付けない  -->
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="transfers:TransferRowViewModel">
                        <Grid Height="38">
                            <Border
                                Margin="4,2"
                                Background="{ThemeResource HakobuneFailedRowBrush}"
                                CornerRadius="4"
                                Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                            <Border
                                Margin="4,2"
                                Background="{ThemeResource HakobuneRetryRowBrush}"
                                CornerRadius="4"
                                Visibility="{x:Bind IsRetrying, Mode=OneWay}" />
                            <Grid Padding="14,0,10,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="380" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  向き（アップロード・ダウンロード）  -->
                                <Grid
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Center">
                                    <Ellipse Fill="{ThemeResource HakobuneAccentTintBrush}" />
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{ThemeResource HakobuneAccentTextBrush}"
                                        Glyph="&#xE74A;"
                                        Visibility="{x:Bind IsUpload}" />
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{ThemeResource HakobuneAccentTextBrush}"
                                        Glyph="&#xE74B;"
                                        Visibility="{x:Bind IsDownload}" />
                                    <!--  サーバーから消す（同期）  -->
                                    <FontIcon
                                        FontSize="11"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Glyph="&#xE74D;"
                                        Visibility="{x:Bind IsDelete}" />
                                </Grid>

                                <!--  名前と送り先  -->
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis">
                                    <Run FontWeight="SemiBold" Text="{x:Bind Name}" />
                                    <Run Text="  " />
                                    <Run
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Destination}" />
                                </TextBlock>

                                <!--  進み具合、または状態  -->
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind IsRunning, Mode=OneWay}">
                                    <ProgressBar
                                        Width="120"
                                        VerticalAlignment="Center"
                                        Maximum="100"
                                        Value="{x:Bind Percent, Mode=OneWay}" />
                                    <TextBlock
                                        Width="36"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind PercentText, Mode=OneWay}"
                                        TextAlignment="Right" />
                                    <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Detail, Mode=OneWay}" />
                                </StackPanel>
                                <Grid
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    ColumnSpacing="8"
                                    Visibility="{x:Bind ShowsStatus, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="16" Height="16">
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{ThemeResource HakobuneRetryTextBrush}"
                                            Glyph="&#xE823;"
                                            Visibility="{x:Bind IsRetrying, Mode=OneWay}" />
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{ThemeResource HakobuneFailedTextBrush}"
                                            Glyph="&#xEB90;"
                                            Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE930;"
                                            Visibility="{x:Bind IsDone, Mode=OneWay}" />
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xEA3A;"
                                            Visibility="{x:Bind IsQueued, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Grid.Column="1">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource HakobuneRetryTextBrush}"
                                            Text="{x:Bind StateLabel, Mode=OneWay}"
                                            Visibility="{x:Bind IsRetrying, Mode=OneWay}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource HakobuneFailedTextBrush}"
                                            Text="{x:Bind StateLabel, Mode=OneWay}"
                                            Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind StateLabel, Mode=OneWay}"
                                            Visibility="{x:Bind ShowsPlainLabel, Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="{x:Bind Detail, Mode=OneWay}" />
                                </Grid>

                                <!--  行ごとの操作  -->
                                <StackPanel
                                    Grid.Column="3"
                                    MinWidth="60"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        AutomationProperties.Name="今すぐ再試行"
                                        Click="OnRetryNowClick"
                                        Style="{StaticResource RowActionButtonStyle}"
                                        ToolTipService.ToolTip="今すぐ再試行"
                                        Visibility="{x:Bind CanRetryNow, Mode=OneWay}">
                                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="失敗の詳細"
                                        Style="{StaticResource RowActionButtonStyle}"
                                        ToolTipService.ToolTip="詳細"
                                        Visibility="{x:Bind CanShowDetails, Mode=OneWay}">
                                        <FontIcon FontSize="14" Glyph="&#xE946;" />
                                        <Button.Flyout>
                                            <Flyout Placement="LeftEdgeAlignedTop">
                                                <TextBlock
                                                    MaxWidth="420"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind FailureDetails, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="送り直す"
                                        Click="OnRetryClick"
                                        Style="{StaticResource RowActionButtonStyle}"
                                        ToolTipService.ToolTip="送り直す"
                                        Visibility="{x:Bind CanRetry, Mode=OneWay}">
                                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="取り消す"
                                        Click="OnCancelClick"
                                        Style="{StaticResource RowActionButtonStyle}"
                                        ToolTipService.ToolTip="取り消す"
                                        Visibility="{x:Bind CanCancel, Mode=OneWay}">
                                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                MaxWidth="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasNoRows, Mode=OneWay}" />
            </Grid>

            <!--  控え  -->
            <Grid Visibility="{x:Bind ViewModel.IsBackupsSelected, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="14,2,8,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Backups.SummaryText, Mode=OneWay}" />
                    <Button
                        Grid.Column="1"
                        Height="32"
                        Padding="10,0"
                        Click="OnOpenBackupFolderClick"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="控えの置き場をエクスプローラーで開く">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE838;" />
                            <TextBlock Text="置き場を開く" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ListView
                    Grid.Row="1"
                    Padding="0,2,0,4"
                    ItemContainerStyle="{StaticResource BackupGroupContainerStyle}"
                    ItemsSource="{x:Bind Backups.Groups, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="backups:BackupGroupViewModel">
                            <StackPanel
                                Padding="0,6,0,8"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                Spacing="2">
                                <!--  操作（同期 1 回など）の見出しと、まとめて元に戻すボタン  -->
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind WhenText}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind SummaryText}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        Height="30"
                                        Padding="10,0"
                                        Command="{x:Bind RestoreAllCommand}"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTipService.ToolTip="この操作の前の状態に戻す（いまの中身は、また控えに残ります）">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource HakobuneAccentTextBrush}"
                                                Glyph="&#xE7A7;" />
                                            <TextBlock Text="{x:Bind RestoreAllText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Grid.Column="3"
                                        AutomationProperties.Name="その他"
                                        Style="{StaticResource RowActionButtonStyle}"
                                        ToolTipService.ToolTip="その他">
                                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Command="{x:Bind DeleteCommand}" Text="この控えを消す">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <!--  控え 1 つずつ  -->
                                <ItemsControl ItemsSource="{x:Bind Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="backups:BackupRowViewModel">
                                            <Grid
                                                MinHeight="30"
                                                Padding="20,0,0,0"
                                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                                ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Padding="8,1,8,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource HakobuneWarningTagBackgroundBrush}"
                                                    CornerRadius="10"
                                                    Visibility="{x:Bind IsOverwritten}">
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource HakobuneWarningTagTextBrush}"
                                                        Text="{x:Bind KindText}" />
                                                </Border>
                                                <Border
                                                    Padding="8,1,8,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource HakobuneFailedBadgeBrush}"
                                                    CornerRadius="10"
                                                    Visibility="{x:Bind IsDeleted}">
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource HakobuneFailedTextBrush}"
                                                        Text="{x:Bind KindText}" />
                                                </Border>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Folder}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    MinWidth="56"
                                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                                    Text="{x:Bind SizeText}"
                                                    TextAlignment="Right" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    MinWidth="76"
                                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                                    Text="{x:Bind WhenText}" />
                                                <Button
                                                    Grid.Column="4"
                                                    AutomationProperties.Name="元に戻す"
                                                    Command="{x:Bind RestoreCommand}"
                                                    Style="{StaticResource RowActionButtonStyle}"
                                                    ToolTipService.ToolTip="元に戻す">
                                                    <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    Padding="20,2,0,0"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="{x:Bind MoreText}"
                                    Visibility="{x:Bind HasMore}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    Grid.Row="1"
                    MaxWidth="460"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind Backups.EmptyText, Mode=OneWay}"
                    TextAlignment="Center"
                    Visibility="{x:Bind helpers:Ui.VisibleUnless(Backups.HasGroups), Mode=OneWay}" />
            </Grid>

            <!--  ログ  -->
            <Grid Visibility="{x:Bind ViewModel.IsLogSelected, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="14,2,8,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        MinWidth="0"
                        Content="通信の詳細も出す（コマンドとサーバーの返事）"
                        IsChecked="{x:Bind Log.ShowsDetails, Mode=TwoWay}" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button
                            Height="32"
                            Padding="10,0"
                            Click="OnCopyLogClick"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTipService.ToolTip="選んだ行（選んでいなければ全部）をコピーする (Ctrl+C)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                <TextBlock Text="コピー" />
                            </StackPanel>
                        </Button>
                        <Button
                            Height="32"
                            Padding="10,0"
                            Click="OnSaveLogClick"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTipService.ToolTip="ログをテキストファイルに保存する">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                <TextBlock Text="保存…" />
                            </StackPanel>
                        </Button>
                        <Button
                            Height="32"
                            Padding="10,0"
                            Command="{x:Bind Log.ClearCommand, Mode=OneWay}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTipService.ToolTip="ログを消す">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                <TextBlock Text="消す" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <ListView
                    x:Name="LogList"
                    Grid.Row="1"
                    Padding="0,2,0,4"
                    ItemContainerStyle="{StaticResource LogRowContainerStyle}"
                    ItemsSource="{x:Bind Log.Rows, Mode=OneWay}"
                    SelectionMode="Extended">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="C"
                            Invoked="OnCopyLogInvoked"
                            Modifiers="Control" />
                    </ListView.KeyboardAccelerators>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="logging:LogRowViewModel">
                            <Grid AutomationProperties.Name="{x:Bind AccessibleText}" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind TimeText}" />
                                <Grid
                                    Grid.Column="1"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center">
                                    <FontIcon
                                        FontSize="13"
                                        Foreground="{ThemeResource HakobuneFailedTextBrush}"
                                        Glyph="&#xEB90;"
                                        Visibility="{x:Bind IsError}" />
                                    <FontIcon
                                        FontSize="13"
                                        Foreground="{ThemeResource HakobuneRetryTextBrush}"
                                        Glyph="&#xE7BA;"
                                        Visibility="{x:Bind IsWarning}" />
                                    <FontIcon
                                        FontSize="13"
                                        Foreground="{ThemeResource HakobuneAccentTextBrush}"
                                        Glyph="&#xE930;"
                                        Visibility="{x:Bind IsSuccess}" />
                                    <FontIcon
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE946;"
                                        Visibility="{x:Bind IsInfo}" />
                                    <FontIcon
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE76C;"
                                        Visibility="{x:Bind IsDetail}" />
                                </Grid>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontFamily="{x:Bind helpers:Ui.LogFont(IsDetail)}"
                                    FontSize="{x:Bind helpers:Ui.LogFontSize(IsDetail)}"
                                    Opacity="{x:Bind helpers:Ui.DimIf(IsDetail)}"
                                    Text="{x:Bind Message}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Message}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    Grid.Row="1"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Log.EmptyText, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind Log.IsEmpty, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>

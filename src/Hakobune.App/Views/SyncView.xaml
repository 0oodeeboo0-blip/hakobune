<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hakobune.App.Views.SyncView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:transfers="using:Hakobune.Presentation.Transfers"
    Language="ja-JP">

    <UserControl.Resources>
        <Style x:Key="SyncChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,1,8,2" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SyncListStyle" TargetType="ListView">
            <Setter Property="SelectionMode" Value="None" />
            <Setter Property="IsItemClickEnabled" Value="False" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0,4,0,4" />
        </Style>

        <Style x:Key="SyncRowContainerStyle" BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,0,10,0" />
        </Style>

        <!--  1 行: 印・位置・大きさ・日時  -->
        <DataTemplate x:Key="SyncRowTemplate" x:DataType="transfers:SyncRow">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Background="{ThemeResource HakobuneAccentTintBrush}"
                    Style="{StaticResource SyncChipStyle}"
                    Visibility="{x:Bind IsNew}">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource HakobuneAccentTextBrush}"
                        Text="{x:Bind Chip}" />
                </Border>
                <Border
                    Background="{ThemeResource HakobuneWarningTagBackgroundBrush}"
                    Style="{StaticResource SyncChipStyle}"
                    Visibility="{x:Bind IsChanged}">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource HakobuneWarningTagTextBrush}"
                        Text="{x:Bind Chip}" />
                </Border>
                <Border
                    Background="{ThemeResource HakobuneFailedBadgeBrush}"
                    Style="{StaticResource SyncChipStyle}"
                    Visibility="{x:Bind IsDelete}">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource HakobuneFailedTextBrush}"
                        Text="{x:Bind Chip}" />
                </Border>
                <Border
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Style="{StaticResource SyncChipStyle}"
                    Visibility="{x:Bind IsOther}">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Chip}" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{x:Bind Path}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Path}" />
                <TextBlock
                    Grid.Column="2"
                    MinWidth="60"
                    HorizontalAlignment="Right"
                    TextAlignment="Right"
                    Style="{StaticResource SecondaryCaptionTextStyle}"
                    Text="{x:Bind SizeText}" />
                <TextBlock
                    Grid.Column="3"
                    MinWidth="76"
                    Style="{StaticResource SecondaryCaptionTextStyle}"
                    Text="{x:Bind WhenText}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!--  同期の確認（ダイアログの中身）。比べている様子と、送るもの・消すもの  -->
    <StackPanel MinWidth="620" Spacing="14">
        <!--  どこからどこへ  -->
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource NameListBoxStyle}">
                <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="12"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{x:Bind ViewModel.SourceLabel}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.SourceText}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SourceText}" />
                </StackPanel>
            </Border>
            <FontIcon
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{ThemeResource HakobuneAccentTextBrush}"
                Glyph="&#xE72A;" />
            <Border Grid.Column="2" Style="{StaticResource NameListBoxStyle}">
                <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="12"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{x:Bind ViewModel.TargetLabel}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.TargetText}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind ViewModel.TargetText}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  比べている途中  -->
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.ScanText, Mode=OneWay}" />
            <ProgressBar IsIndeterminate="True" />
            <TextBlock
                FontSize="12"
                Style="{StaticResource SecondaryTextStyle}"
                Text="ファイルの中身は読まず、名前・大きさ・更新日時で比べます。" />
        </StackPanel>

        <!--  比べられなかった  -->
        <Border Style="{StaticResource CriticalBoxStyle}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
            <TextBlock Style="{StaticResource CriticalTextStyle}" Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />
        </Border>

        <!--  比べた結果  -->
        <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}">
            <!--  まとめ  -->
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Background="{ThemeResource HakobuneAccentTintBrush}" Style="{StaticResource SyncChipStyle}">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource HakobuneAccentTextBrush}"
                        Text="{x:Bind ViewModel.NewText, Mode=OneWay}" />
                </Border>
                <Border Background="{ThemeResource HakobuneWarningTagBackgroundBrush}" Style="{StaticResource SyncChipStyle}">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource HakobuneWarningTagTextBrush}"
                        Text="{x:Bind ViewModel.ChangedText, Mode=OneWay}" />
                </Border>
                <Border
                    Background="{ThemeResource HakobuneWarningTagBackgroundBrush}"
                    Style="{StaticResource SyncChipStyle}"
                    Visibility="{x:Bind ViewModel.HasTargetNewerRows, Mode=OneWay}">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource HakobuneWarningTagTextBrush}"
                        Text="{x:Bind ViewModel.TargetNewerText, Mode=OneWay}" />
                </Border>
                <Border
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Style="{StaticResource SyncChipStyle}"
                    Visibility="{x:Bind ViewModel.HasOnlyOnTargetRows, Mode=OneWay}">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.OnlyOnTargetText, Mode=OneWay}" />
                </Border>
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" Style="{StaticResource SyncChipStyle}">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SameText, Mode=OneWay}" />
                </Border>
            </StackPanel>

            <!--  送るもの  -->
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SendHeader, Mode=OneWay}" />
                <ListView
                    MaxHeight="232"
                    AutomationProperties.Name="{x:Bind ViewModel.SendHeader, Mode=OneWay}"
                    ItemContainerStyle="{StaticResource SyncRowContainerStyle}"
                    ItemTemplate="{StaticResource SyncRowTemplate}"
                    ItemsSource="{x:Bind ViewModel.SendRows, Mode=OneWay}"
                    Style="{StaticResource SyncListStyle}"
                    Visibility="{x:Bind ViewModel.HasSendRows, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.NothingToSendText}"
                    Visibility="{x:Bind ViewModel.ShowsNothingToSend, Mode=OneWay}" />
            </StackPanel>

            <!--  送り先のほうが新しいもの（既定では送らない）  -->
            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasTargetNewerRows, Mode=OneWay}">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.TargetNewerHeader, Mode=OneWay}" />
                <TextBlock
                    FontSize="12"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.TargetNewerHint}" />
                <CheckBox Content="{x:Bind ViewModel.IncludeTargetNewerText}" IsChecked="{x:Bind ViewModel.IncludeTargetNewer, Mode=TwoWay}" />
                <ListView
                    MaxHeight="128"
                    AutomationProperties.Name="{x:Bind ViewModel.TargetNewerHeader, Mode=OneWay}"
                    ItemContainerStyle="{StaticResource SyncRowContainerStyle}"
                    ItemTemplate="{StaticResource SyncRowTemplate}"
                    ItemsSource="{x:Bind ViewModel.TargetNewerRows, Mode=OneWay}"
                    Style="{StaticResource SyncListStyle}" />
            </StackPanel>

            <!--  送り先にだけあるもの（アップロードなら、消すこともできる）  -->
            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasOnlyOnTargetRows, Mode=OneWay}">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.OnlyOnTargetHeader, Mode=OneWay}" />
                <CheckBox
                    Content="サーバーからも消す（パソコンと同じにする）"
                    IsChecked="{x:Bind ViewModel.DeleteOnlyOnTarget, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.CanDeleteOnlyOnTarget, Mode=OneWay}" />
                <TextBlock
                    FontSize="12"
                    Style="{StaticResource CriticalTextStyle}"
                    Text="サーバーから消したものは、元に戻せません。消すものをよく確かめてください。"
                    Visibility="{x:Bind ViewModel.ShowsDeleteWarning, Mode=OneWay}" />
                <TextBlock
                    FontSize="12"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="消す前に控えを取ります。下の一覧の「控え」から元に戻せます（100 MB より大きいファイルは除きます）。"
                    Visibility="{x:Bind ViewModel.ShowsDeleteBackupNote, Mode=OneWay}" />
                <ListView
                    MaxHeight="128"
                    AutomationProperties.Name="{x:Bind ViewModel.OnlyOnTargetHeader, Mode=OneWay}"
                    ItemContainerStyle="{StaticResource SyncRowContainerStyle}"
                    ItemTemplate="{StaticResource SyncRowTemplate}"
                    ItemsSource="{x:Bind ViewModel.OnlyOnTargetRows, Mode=OneWay}"
                    Style="{StaticResource SyncListStyle}" />
            </StackPanel>

            <!--  種類が違うもの（送れない）  -->
            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasConflictRows, Mode=OneWay}">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.ConflictHeader, Mode=OneWay}" />
                <ListView
                    MaxHeight="96"
                    AutomationProperties.Name="{x:Bind ViewModel.ConflictHeader, Mode=OneWay}"
                    ItemContainerStyle="{StaticResource SyncRowContainerStyle}"
                    ItemTemplate="{StaticResource SyncRowTemplate}"
                    ItemsSource="{x:Bind ViewModel.ConflictRows, Mode=OneWay}"
                    Style="{StaticResource SyncListStyle}" />
            </StackPanel>

            <!--  補足  -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasNotes, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid Margin="0,2,0,2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Margin="0,2,0,0"
                                VerticalAlignment="Top"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE946;" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="12"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>

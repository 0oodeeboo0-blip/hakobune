<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hakobune.App.Views.FfftpImportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:connections="using:Hakobune.Presentation.Connections"
    Language="ja-JP">

    <UserControl.Resources>
        <Style x:Key="ImportListStyle" TargetType="ListView">
            <Setter Property="SelectionMode" Value="None" />
            <Setter Property="IsItemClickEnabled" Value="False" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0,4,0,4" />
        </Style>

        <Style x:Key="ImportRowContainerStyle" BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="10,2,10,2" />
        </Style>

        <!--  1 行: 選ぶ・名前とグループ・方式とアドレス・注意  -->
        <DataTemplate x:Key="ImportRowTemplate" x:DataType="connections:FfftpImportRow">
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    MinWidth="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind AccessibleName}"
                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                <StackPanel
                    Grid.Column="1"
                    Padding="0,4"
                    VerticalAlignment="Center"
                    Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            Padding="6,0,6,1"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Visibility="{x:Bind HasGroup}">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind GroupText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind DetailText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource HakobuneWarningTagTextBrush}"
                        Text="{x:Bind NoteText}"
                        Visibility="{x:Bind HasNote}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!--  FFFTP から接続先を読み込む（ダイアログの中身）  -->
    <StackPanel MinWidth="560" Spacing="12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    FontSize="12"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="読み込む元" />
                <TextBlock Text="{x:Bind ViewModel.SourceText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <HyperlinkButton
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.ChooseFileCommand}"
                Content="ffftp.ini・.reg から読み込む…" />
        </Grid>

        <Border Style="{StaticResource CriticalBoxStyle}" Visibility="{x:Bind ViewModel.HasProblem, Mode=OneWay}">
            <TextBlock Style="{StaticResource CriticalTextStyle}" Text="{x:Bind ViewModel.ProblemText, Mode=OneWay}" />
        </Border>

        <!--  マスターパスワード（FFFTP で決めてあるときだけ）  -->
        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.NeedsMasterPassword, Mode=OneWay}">
            <TextBlock
                FontSize="12"
                Style="{StaticResource SecondaryTextStyle}"
                Text="{x:Bind ViewModel.PasswordNote, Mode=OneWay}"
                TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PasswordBox
                    x:Name="MasterPasswordInput"
                    Width="260"
                    AutomationProperties.Name="FFFTP のマスターパスワード"
                    KeyDown="OnMasterPasswordKeyDown"
                    PasswordChanged="OnMasterPasswordChanged"
                    PlaceholderText="FFFTP のマスターパスワード" />
                <Button Command="{x:Bind ViewModel.CheckMasterPasswordCommand}" Content="確かめる" />
            </StackPanel>
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource HakobuneFailedTextBrush}"
                Text="{x:Bind ViewModel.MasterPasswordMessage, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay}">
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="読み込む接続先" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="4">
                    <HyperlinkButton Command="{x:Bind ViewModel.SelectAllCommand}" Content="すべて選ぶ" />
                    <HyperlinkButton Command="{x:Bind ViewModel.SelectNoneCommand}" Content="すべて外す" />
                </StackPanel>
            </Grid>
            <ListView
                MaxHeight="340"
                AutomationProperties.Name="読み込む接続先"
                ItemContainerStyle="{StaticResource ImportRowContainerStyle}"
                ItemTemplate="{StaticResource ImportRowTemplate}"
                ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                Style="{StaticResource ImportListStyle}" />
            <TextBlock
                FontSize="12"
                Style="{StaticResource SecondaryTextStyle}"
                Text="{x:Bind ViewModel.PasswordNote, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.ShowsPasswordNoteBelow, Mode=OneWay}" />
        </StackPanel>

        <TextBlock
            Style="{StaticResource SecondaryTextStyle}"
            Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ShowsEmptyText, Mode=OneWay}" />
    </StackPanel>
</UserControl>

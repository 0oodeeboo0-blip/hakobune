<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hakobune.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Language="ja-JP">

    <!--  設定（ダイアログの中身）。変えるとすぐに反映して保存する  -->
    <StackPanel MinWidth="500" Spacing="4">
        <TextBlock
            Margin="0,0,0,4"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="見た目" />

        <Grid Style="{StaticResource SettingsCardStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="&#xE790;" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="画面の色" />
                <TextBlock
                    FontSize="12"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="ライトかダークを選びます" />
            </StackPanel>
            <ComboBox
                x:Name="ThemeBox"
                Grid.Column="2"
                MinWidth="210"
                VerticalAlignment="Center"
                AutomationProperties.Name="画面の色"
                SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" />
        </Grid>

        <Grid Style="{StaticResource SettingsCardStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="&#xE8FD;" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="一覧の行を詰める（コンパクト）" />
                <TextBlock
                    FontSize="12"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="ファイルの一覧に、一度にたくさんの行を出します" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="2"
                MinWidth="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="一覧の行を詰める"
                IsOn="{x:Bind ViewModel.UseCompactRows, Mode=TwoWay}"
                OffContent="オフ"
                OnContent="オン" />
        </Grid>

        <TextBlock
            Margin="0,16,0,4"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="パソコン側" />

        <Grid Style="{StaticResource SettingsCardStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="&#xE890;" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="隠しファイルを表示する" />
                <TextBlock
                    FontSize="12"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="隠し属性のファイルとフォルダも一覧に出し、フォルダごと送るときにも含めます（Windows のシステムのファイルは除きます）" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="2"
                MinWidth="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="隠しファイルを表示する"
                IsOn="{x:Bind ViewModel.ShowHiddenFiles, Mode=TwoWay}"
                OffContent="オフ"
                OnContent="オン" />
        </Grid>

        <TextBlock
            Margin="0,16,0,4"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="このアプリについて" />

        <Grid Style="{StaticResource SettingsCardStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--  アプリのアイコン（タイトルバーと同じ）  -->
            <Canvas
                Width="20"
                Height="20"
                VerticalAlignment="Center">
                <Rectangle
                    Width="20"
                    Height="20"
                    Fill="{ThemeResource HakobuneBrandBrush}"
                    RadiusX="5"
                    RadiusY="5" />
                <Rectangle
                    Canvas.Left="7.25"
                    Canvas.Top="4.25"
                    Width="5.5"
                    Height="5"
                    Fill="White"
                    RadiusX="1"
                    RadiusY="1" />
                <Path Data="M 3.5,10.75 L 16.5,10.75 L 14.95,14.15 A 2,2 0 0 1 13.13,15.32 L 6.87,15.32 A 2,2 0 0 1 5.05,14.15 Z" Fill="White" />
            </Canvas>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Hakobune" />
                <TextBlock
                    FontSize="12"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.VersionText}" />
            </StackPanel>
            <HyperlinkButton
                Grid.Column="2"
                VerticalAlignment="Center"
                Content="GitHub で見る"
                NavigateUri="https://github.com/0oodeeboo0-blip/hakobune" />
        </Grid>

        <Grid Style="{StaticResource SettingsCardStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="&#xE8B7;" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="保存の場所" />
                <TextBlock
                    FontSize="12"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.DataDirectory}"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontSize="12"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="接続先・送信待ち・設定。パスワードは Windows の資格情報マネージャーにあります" />
            </StackPanel>
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Click="OnOpenDataFolder"
                Content="フォルダを開く" />
        </Grid>
    </StackPanel>
</UserControl>

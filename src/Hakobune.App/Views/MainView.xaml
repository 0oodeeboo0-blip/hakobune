<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Hakobune.App.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conn="using:Hakobune.Presentation.Connections"
    xmlns:helpers="using:Hakobune.App.Helpers"
    xmlns:views="using:Hakobune.App.Views"
    Language="ja-JP">

    <UserControl.KeyboardAccelerators>
        <!--  FFFTP と同じ: Ctrl+Q でクイック接続  -->
        <KeyboardAccelerator
            Key="Q"
            Invoked="OnQuickConnectInvoked"
            Modifiers="Control" />
        <!--  FFFTP と同じ: Ctrl+U でアップロード、Ctrl+D でダウンロード  -->
        <KeyboardAccelerator
            Key="U"
            Invoked="OnUploadInvoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="D"
            Invoked="OnDownloadInvoked"
            Modifiers="Control" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!--  タイトルバー（つかんでウインドウを動かせる部分）  -->
        <Grid
            x:Name="AppTitleBar"
            Padding="14,0,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  アプリのアイコン（舟と荷物）  -->
            <Canvas
                Width="20"
                Height="20"
                VerticalAlignment="Center">
                <Rectangle
                    Width="20"
                    Height="20"
                    Fill="{ThemeResource HakobuneBrandBrush}"
                    RadiusX="5"
                    RadiusY="5" />
                <Rectangle
                    Canvas.Left="7.25"
                    Canvas.Top="4.25"
                    Width="5.5"
                    Height="5"
                    Fill="White"
                    RadiusX="1"
                    RadiusY="1" />
                <Path Data="M 3.5,10.75 L 16.5,10.75 L 14.95,14.15 A 2,2 0 0 1 13.13,15.32 L 6.87,15.32 A 2,2 0 0 1 5.05,14.15 Z" Fill="White" />
            </Canvas>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Text="Hakobune" />

            <!--  いまの接続（暗号化しているか、どこにつないでいるか）  -->
            <Border
                Grid.Column="2"
                Height="28"
                Padding="10,0,12,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind ViewModel.Connection.AccessibleName, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource HakobuneAccentTextBrush}"
                        Glyph="&#xE72E;"
                        Visibility="{x:Bind ViewModel.Connection.ShowsSecure, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource HakobuneAccentTextBrush}"
                        Text="{x:Bind ViewModel.Connection.SecurityText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Connection.ShowsSecure, Mode=OneWay}" />
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource HakobuneWarningTagTextBrush}"
                        Glyph="&#xE785;"
                        Visibility="{x:Bind ViewModel.Connection.ShowsInsecure, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource HakobuneWarningTagTextBrush}"
                        Text="{x:Bind ViewModel.Connection.SecurityText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Connection.ShowsInsecure, Mode=OneWay}" />
                    <Rectangle
                        Width="1"
                        Height="14"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.Connection.IsConnected, Mode=OneWay}" />
                    <ProgressRing
                        Width="14"
                        Height="14"
                        MinWidth="0"
                        MinHeight="0"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsConnecting, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsConnecting, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{x:Bind ViewModel.Connection.Name, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.Connection.Host, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Connection.IsConnected, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  ツールバー  -->
        <Grid Grid.Row="1" Padding="12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button
                    AutomationProperties.Name="接続先の一覧を開閉"
                    Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                    Style="{StaticResource SubtleIconButtonStyle}"
                    ToolTipService.ToolTip="接続先の一覧を開閉">
                    <FontIcon FontSize="16" Glyph="{x:Bind helpers:Ui.SidebarGlyph(ViewModel.IsSidebarOpen), Mode=OneWay}" />
                </Button>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button
                    Command="{x:Bind ViewModel.UploadCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="選んだファイルをサーバーへ送る (Ctrl+U)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource HakobuneAccentTextBrush}"
                            Glyph="&#xE898;" />
                        <TextBlock Text="アップロード" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{x:Bind ViewModel.DownloadCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="選んだファイルをパソコンへ受け取る (Ctrl+D)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource HakobuneAccentTextBrush}"
                            Glyph="&#xE896;" />
                        <TextBlock Text="ダウンロード" />
                    </StackPanel>
                </Button>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8F4;" />
                        <TextBlock Text="新しいフォルダ" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8AC;" />
                        <TextBlock Text="名前の変更" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE74D;" />
                        <TextBlock Text="削除" />
                    </StackPanel>
                </Button>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="一覧を取り直す (F5)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                        <TextBlock Text="更新" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE895;" />
                        <TextBlock Text="同期" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="2">
                <Button Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                        <TextBlock Text="表示" />
                        <FontIcon FontSize="10" Glyph="&#xE70D;" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.Name="その他の操作"
                    Style="{StaticResource SubtleIconButtonStyle}"
                    ToolTipService.ToolTip="その他の操作">
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Command="{x:Bind ViewModel.NewConnectionCommand}" Text="新しい接続…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE710;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Command="{x:Bind ViewModel.QuickConnectCommand}"
                                KeyboardAcceleratorTextOverride="Ctrl+Q"
                                Text="クイック接続…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE703;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind ViewModel.DisconnectCommand}" Text="切断">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8CD;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!--  本体: 接続先の一覧、2 画面、転送の一覧  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid
                Width="248"
                Padding="12,0,8,12"
                Visibility="{x:Bind ViewModel.IsSidebarOpen, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="8,0,0,0">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="接続先" />
                    <Button
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="新しい接続"
                        Command="{x:Bind ViewModel.NewConnectionCommand}"
                        Style="{StaticResource SubtleIconButtonStyle}"
                        ToolTipService.ToolTip="新しい接続">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Connections.Groups}" XYFocusKeyboardNavigation="Enabled">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="conn:ConnectionGroupViewModel">
                                <StackPanel Margin="0,0,0,8">
                                    <Button
                                        AutomationProperties.Name="{x:Bind Name}"
                                        Command="{x:Bind ToggleCommand}"
                                        Style="{StaticResource SidebarGroupButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE70D;"
                                                RenderTransformOrigin="0.5,0.5">
                                                <FontIcon.RenderTransform>
                                                    <RotateTransform Angle="{x:Bind ChevronRotation, Mode=OneWay}" />
                                                </FontIcon.RenderTransform>
                                            </FontIcon>
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Name}" />
                                        </StackPanel>
                                    </Button>
                                    <ItemsControl ItemsSource="{x:Bind Items}" Visibility="{x:Bind IsExpanded, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="conn:ConnectionItemViewModel">
                                                <Grid Height="48" Margin="0,0,0,2">
                                                    <Border
                                                        Background="{ThemeResource HakobuneAccentTintBrush}"
                                                        CornerRadius="6"
                                                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                                    <Rectangle
                                                        Width="3"
                                                        Height="16"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Fill="{ThemeResource HakobuneAccentTextBrush}"
                                                        RadiusX="1.5"
                                                        RadiusY="1.5"
                                                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                                    <Button
                                                        AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                                        Click="OnConnectionClick"
                                                        Style="{StaticResource SidebarItemButtonStyle}"
                                                        ToolTipService.ToolTip="{x:Bind Subtitle, Mode=OneWay}">
                                                        <Button.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem
                                                                    Click="OnConnectMenuClick"
                                                                    Tag="{x:Bind}"
                                                                    Text="接続"
                                                                    Visibility="{x:Bind helpers:Ui.VisibleUnlessAny(IsConnected, IsConnecting), Mode=OneWay}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE703;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem
                                                                    Click="OnDisconnectMenuClick"
                                                                    Tag="{x:Bind}"
                                                                    Text="切断"
                                                                    Visibility="{x:Bind IsConnected, Mode=OneWay}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE8CD;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem
                                                                    Click="OnDisconnectMenuClick"
                                                                    Tag="{x:Bind}"
                                                                    Text="接続をやめる"
                                                                    Visibility="{x:Bind IsConnecting, Mode=OneWay}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE711;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutSeparator />
                                                                <MenuFlyoutItem
                                                                    Click="OnEditMenuClick"
                                                                    Tag="{x:Bind}"
                                                                    Text="編集…"
                                                                    Visibility="{x:Bind helpers:Ui.VisibleUnless(IsTemporary), Mode=OneWay}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE70F;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem
                                                                    Click="OnEditMenuClick"
                                                                    Tag="{x:Bind}"
                                                                    Text="接続先として保存…"
                                                                    Visibility="{x:Bind IsTemporary, Mode=OneWay}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE74E;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem
                                                                    Click="OnDuplicateMenuClick"
                                                                    Tag="{x:Bind}"
                                                                    Text="複製"
                                                                    Visibility="{x:Bind helpers:Ui.VisibleUnless(IsTemporary), Mode=OneWay}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE8C8;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutSeparator />
                                                                <MenuFlyoutItem
                                                                    Click="OnDeleteMenuClick"
                                                                    Tag="{x:Bind}"
                                                                    Text="削除…"
                                                                    Visibility="{x:Bind helpers:Ui.VisibleUnless(IsTemporary), Mode=OneWay}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE74D;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem
                                                                    Click="OnDeleteMenuClick"
                                                                    Tag="{x:Bind}"
                                                                    Text="一覧から外す"
                                                                    Visibility="{x:Bind IsTemporary, Mode=OneWay}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE738;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Button.ContextFlyout>
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <!--  サーバーのアイコン  -->
                                                            <Grid
                                                                Width="20"
                                                                Height="20"
                                                                VerticalAlignment="Center">
                                                                <Canvas Visibility="{x:Bind IsSelected, Mode=OneWay}">
                                                                    <Rectangle
                                                                        Canvas.Left="2.25"
                                                                        Canvas.Top="2.5"
                                                                        Width="15.5"
                                                                        Height="7.25"
                                                                        RadiusX="2.25"
                                                                        RadiusY="2.25"
                                                                        Stroke="{ThemeResource HakobuneAccentTextBrush}"
                                                                        StrokeThickness="1.5" />
                                                                    <Rectangle
                                                                        Canvas.Left="2.25"
                                                                        Canvas.Top="10.25"
                                                                        Width="15.5"
                                                                        Height="7.25"
                                                                        RadiusX="2.25"
                                                                        RadiusY="2.25"
                                                                        Stroke="{ThemeResource HakobuneAccentTextBrush}"
                                                                        StrokeThickness="1.5" />
                                                                    <Ellipse
                                                                        Canvas.Left="5.35"
                                                                        Canvas.Top="5.2"
                                                                        Width="1.8"
                                                                        Height="1.8"
                                                                        Fill="{ThemeResource HakobuneAccentTextBrush}" />
                                                                    <Ellipse
                                                                        Canvas.Left="5.35"
                                                                        Canvas.Top="13"
                                                                        Width="1.8"
                                                                        Height="1.8"
                                                                        Fill="{ThemeResource HakobuneAccentTextBrush}" />
                                                                </Canvas>
                                                                <Canvas Visibility="{x:Bind IsNotSelected, Mode=OneWay}">
                                                                    <Rectangle
                                                                        Canvas.Left="2.25"
                                                                        Canvas.Top="2.5"
                                                                        Width="15.5"
                                                                        Height="7.25"
                                                                        RadiusX="2.25"
                                                                        RadiusY="2.25"
                                                                        Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        StrokeThickness="1.5" />
                                                                    <Rectangle
                                                                        Canvas.Left="2.25"
                                                                        Canvas.Top="10.25"
                                                                        Width="15.5"
                                                                        Height="7.25"
                                                                        RadiusX="2.25"
                                                                        RadiusY="2.25"
                                                                        Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        StrokeThickness="1.5" />
                                                                    <Ellipse
                                                                        Canvas.Left="5.35"
                                                                        Canvas.Top="5.2"
                                                                        Width="1.8"
                                                                        Height="1.8"
                                                                        Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    <Ellipse
                                                                        Canvas.Left="5.35"
                                                                        Canvas.Top="13"
                                                                        Width="1.8"
                                                                        Height="1.8"
                                                                        Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </Canvas>
                                                            </Grid>
                                                            <!--  1 行目: 名前（と暗号化なしの印）、2 行目: 方式とホスト  -->
                                                            <Grid
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                ColumnSpacing="6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <TextBlock
                                                                    FontWeight="{x:Bind helpers:Ui.SemiBoldIf(IsSelected), Mode=OneWay}"
                                                                    Text="{x:Bind Name, Mode=OneWay}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <Border
                                                                    Grid.Column="1"
                                                                    Height="18"
                                                                    Padding="5,0"
                                                                    VerticalAlignment="Center"
                                                                    Background="{ThemeResource HakobuneWarningTagBackgroundBrush}"
                                                                    CornerRadius="4"
                                                                    Visibility="{x:Bind IsInsecure, Mode=OneWay}">
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="11"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{ThemeResource HakobuneWarningTagTextBrush}"
                                                                        Text="暗号化なし" />
                                                                </Border>
                                                                <TextBlock
                                                                    Grid.Row="1"
                                                                    Grid.ColumnSpan="2"
                                                                    FontSize="12"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind Subtitle, Mode=OneWay}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                            <!--  接続中の印  -->
                                                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                                                <Ellipse
                                                                    Width="8"
                                                                    Height="8"
                                                                    VerticalAlignment="Center"
                                                                    Fill="{ThemeResource HakobuneAccentTextBrush}"
                                                                    Visibility="{x:Bind IsConnected, Mode=OneWay}" />
                                                                <ProgressRing
                                                                    Width="16"
                                                                    Height="16"
                                                                    MinWidth="0"
                                                                    MinHeight="0"
                                                                    VerticalAlignment="Center"
                                                                    IsActive="{x:Bind IsConnecting, Mode=OneWay}"
                                                                    Visibility="{x:Bind IsConnecting, Mode=OneWay}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--  接続先がまだ無いときの案内  -->
                <StackPanel
                    Grid.Row="1"
                    Margin="8,16,8,0"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.Connections.IsEmpty, Mode=OneWay}">
                    <TextBlock FontWeight="SemiBold" Text="接続先はまだありません" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="サーバーのアドレスとログインの情報を登録すると、ここに並びます。クリックすると接続します。"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,4,0,0"
                        Command="{x:Bind ViewModel.NewConnectionCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="新しい接続" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button
                    Grid.Row="2"
                    Height="40"
                    Padding="10,0"
                    HorizontalContentAlignment="Left"
                    Style="{StaticResource SidebarItemButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                        <TextBlock Text="設定" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid
                Grid.Column="1"
                Padding="{x:Bind helpers:Ui.ContentPadding(ViewModel.IsSidebarOpen), Mode=OneWay}"
                RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <views:FilePaneView x:Name="LocalPane" />
                    <views:FilePaneView x:Name="RemotePane" Grid.Column="1" />
                </Grid>
                <views:TransferPanelView x:Name="TransferPanel" Grid.Row="1" />
            </Grid>
        </Grid>

        <!--  ステータスバー: 全体の進み具合  -->
        <Grid
            Grid.Row="3"
            Padding="14,0"
            Background="{ThemeResource HakobuneStatusBarBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.Transfers.HasItems, Mode=OneWay}">
                <ProgressBar
                    Width="140"
                    VerticalAlignment="Center"
                    Maximum="100"
                    Value="{x:Bind ViewModel.Transfers.OverallPercent, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{x:Bind ViewModel.Transfers.OverallPercentText, Mode=OneWay}" />
                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.Transfers.CountText, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.Transfers.IdleText, Mode=OneWay}" />
            <TextBlock
                Grid.Column="1"
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Text="{x:Bind ViewModel.Transfers.SpeedText, Mode=OneWay}" />
            <TextBlock
                Grid.Column="2"
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Text="{x:Bind ViewModel.Transfers.RemainingText, Mode=OneWay}" />
            <TextBlock
                Grid.Column="4"
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Text="{x:Bind ViewModel.Transfers.ConcurrencyText, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
